{
  "name": "horizon",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Horizon standalone browser",
  "author": "TXMSKA",
  "homepage": "https://txmska.com/projects/horizon/",
  "main": "dist/electron/main.js",
  "engines": {
    "node": "^24.0.0 || ^26.0.0",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build && node scripts/contrast.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "start": "node scripts/start.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "fuses": "node scripts/fuses.mjs",
    "setup:gitleaks": "node scripts/setup-gitleaks.mjs",
    "test:security": "node --test scripts/security.test.cjs",
    "verify:window": "electron scripts/verify-foundation.cjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts-experimental": "7.4.15"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
